---
/**
 * The end-to-end pipeline, as a diagram.
 *
 * Hand-authored SVG rather than a diagram-as-code renderer: it costs no
 * dependency and no client JavaScript, stays crisp at any zoom, and lets the
 * two things that actually matter be shown structurally — the acceptance gate
 * after step 2, and the fact that steps 3–4 exist only to remove the tether.
 *
 * Colours come from Starlight's theme tokens, so it follows light/dark.
 */

// Steps come from `src/data/pipeline.ts` so this diagram and the compact strip
// at the top of every step page cannot disagree about order or numbering.
import {
  PIPELINE_STEPS,
  tetheredSteps as tethered,
  standaloneSteps as standalone,
} from '../data/pipeline';

/**
 * Both labels are shared by the two views below, so the wide diagram and the
 * narrow list cannot end up quoting different acceptance thresholds.
 */
const GATE_LABEL = 'balanced ≥ 0.85';
const GROUP_LABEL = 'only to remove the tether';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (slug: string) => `${base}/${slug}/`;

// Geometry. One place to change spacing; everything else is derived.
const W = 176;
const H = 74;
const GAP = 30;
const X0 = 10;
const ROW1 = 44;
const ROW2 = 210;
const x = (i: number) => X0 + i * (W + GAP);
const VIEW_W = X0 * 2 + 3 * W + 2 * GAP;
const VIEW_H = 300;
---

<figure class="pipeline">
  <svg
    viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
    role="img"
    aria-labelledby="pipeline-title pipeline-desc"
    preserveAspectRatio="xMidYMid meet"
  >
    <title id="pipeline-title">The end-to-end pipeline, in five steps</title>
    <desc id="pipeline-desc">
      Steps 0 to 2 run in order: system identification, training in simulation,
      then fine-tuning and testing the teacher on the real rig, tethered to a
      laptop. If the teacher scores a balanced fraction of at least 0.85, steps 3
      and 4 follow — distilling and gating a smaller student, then flashing and
      scoring it running standalone on the Nano. Stopping after step 2 leaves a
      working controller that needs the laptop attached.
    </desc>

    <defs>
      <marker
        id="pipeline-arrow"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" class="arrowhead" />
      </marker>
    </defs>

    {/* Steps 3–4 only exist to remove the tether: group and label them. */}
    <g class="group">
      <rect
        x={X0 - 6}
        y={ROW2 - 30}
        width={2 * W + 1 * GAP + 12}
        height={H + 46}
        rx="12"
      />
      <text x={X0 + 4} y={ROW2 - 12} class="group-label">
        {GROUP_LABEL}
      </text>
    </g>

    {/* Row 1: the tethered pipeline. */}
    {
      tethered.map((step, i) => (
        <a href={url(step.slug)} class="node">
          <rect x={x(i)} y={ROW1} width={W} height={H} rx="10" />
          <text x={x(i) + 14} y={ROW1 + 28} class="num">
            {step.n}
          </text>
          <text x={x(i) + 38} y={ROW1 + 28} class="title">
            {step.title}
          </text>
          <text x={x(i) + 14} y={ROW1 + 52} class="sub">
            {step.sub}
          </text>
        </a>
      ))
    }
    {
      tethered.slice(0, -1).map((_, i) => (
        <line
          x1={x(i) + W}
          y1={ROW1 + H / 2}
          x2={x(i + 1) - 6}
          y2={ROW1 + H / 2}
          class="link"
          marker-end="url(#pipeline-arrow)"
        />
      ))
    }

    {/* Row 2: the tether-removal pipeline. */}
    {
      standalone.map((step, i) => (
        <a href={url(step.slug)} class="node node--optional">
          <rect x={x(i)} y={ROW2} width={W} height={H} rx="10" />
          <text x={x(i) + 14} y={ROW2 + 28} class="num">
            {step.n}
          </text>
          <text x={x(i) + 38} y={ROW2 + 28} class="title">
            {step.title}
          </text>
          <text x={x(i) + 14} y={ROW2 + 52} class="sub">
            {step.sub}
          </text>
        </a>
      ))
    }
    {
      standalone.slice(0, -1).map((_, i) => (
        <line
          x1={x(i) + W}
          y1={ROW2 + H / 2}
          x2={x(i + 1) - 6}
          y2={ROW2 + H / 2}
          class="link"
          marker-end="url(#pipeline-arrow)"
        />
      ))
    }

    {/* The acceptance gate: step 2 wraps down to step 3 only if it scores. */}
    <path
      d={`M ${x(2) + W / 2} ${ROW1 + H}
          V ${ROW1 + H + 42}
          H ${x(0) + W / 2}
          V ${ROW2 - 36}`}
      class="link link--gate"
      marker-end="url(#pipeline-arrow)"
    />
    <text x={x(2) + W / 2 - 10} y={ROW1 + H + 32} class="gate-label" text-anchor="end">
      {GATE_LABEL}
    </text>
  </svg>

  {/*
    The same seven steps for viewports too narrow for the diagram. Two rows of
    176px nodes need 34rem; a phone has about 20rem of content column, and
    scaling the SVG down to fit shrinks its labels past reading size. So the
    narrow case reflows instead of zooming — one step per row, which is the
    shape the sequence has anyway.

    Both views are driven by PIPELINE_STEPS, so they can only differ in layout.
  */}
  <ol class="pipeline__list">
    {
      PIPELINE_STEPS.map((step, i) => (
        <>
          {!step.tethered && PIPELINE_STEPS[i - 1]?.tethered && (
            <li class="pipeline__gate" aria-hidden="true">
              <span>{GATE_LABEL}</span>
              <span class="pipeline__group-label">{GROUP_LABEL}</span>
            </li>
          )}
          <li>
            <a
              href={url(step.slug)}
              class:list={['pipeline__row', { 'pipeline__row--optional': !step.tethered }]}
            >
              <span class="pipeline__n">{step.n}</span>
              <span class="pipeline__title">{step.title}</span>
              <span class="pipeline__sub">{step.sub}</span>
            </a>
          </li>
        </>
      ))
    }
  </ol>

  <figcaption>
    Each step is idempotent and can be re-run on its own. Stopping after step 2
    leaves a rig that balances with the laptop attached.
  </figcaption>
</figure>

<style>
  .pipeline {
    margin: 1.75rem 0;
  }

  .pipeline svg {
    display: block;
    width: 100%;
    min-width: 34rem;
    height: auto;
  }

  /* One view or the other, never both. Below 40rem the diagram cannot hold its
     two rows without either overflowing or shrinking its labels past reading
     size, so the list takes over. No overflow-x here on purpose: a figure you
     have to scroll sideways to read is not a diagram, it is a puzzle. */
  .pipeline__list {
    display: none;
  }

  @media (max-width: 40rem) {
    .pipeline svg {
      display: none;
    }

    .pipeline__list {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }

  .pipeline__list li {
    margin: 0;
    padding: 0;
  }

  .pipeline__row {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.1rem 0.6rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .pipeline__row:hover,
  .pipeline__row:focus-visible {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  /* Steps 4-6 are optional; dashed, matching node--optional in the diagram. */
  .pipeline__row--optional {
    border-style: dashed;
  }

  .pipeline__n {
    grid-row: span 2;
    align-self: center;
    color: var(--sl-color-accent);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .pipeline__title {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .pipeline__sub {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  /* The acceptance gate, as a labelled break between the two phases. */
  .pipeline__gate {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0.35rem 0 0.1rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--sl-color-gray-4);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    font-style: italic;
  }

  .pipeline__group-label {
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .node rect {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-gray-5);
    stroke-width: 1.5;
    transition:
      stroke 0.15s ease,
      fill 0.15s ease;
  }

  .node:hover rect,
  .node:focus-visible rect {
    stroke: var(--sl-color-accent);
    fill: var(--sl-color-accent-low);
  }

  .node:focus-visible {
    outline: none;
  }

  .node--optional rect {
    stroke-dasharray: 5 4;
  }

  .num {
    fill: var(--sl-color-accent);
    font-size: 1rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .title {
    fill: var(--sl-color-white);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .sub {
    fill: var(--sl-color-gray-3);
    font-size: 0.78rem;
  }

  .link {
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.75;
    fill: none;
  }

  .link--gate {
    stroke-dasharray: 6 4;
  }

  .arrowhead {
    fill: var(--sl-color-gray-4);
  }

  .gate-label {
    fill: var(--sl-color-gray-3);
    font-size: 0.78rem;
    font-style: italic;
  }

  .group rect {
    fill: none;
    stroke: var(--sl-color-gray-5);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }

  .group-label {
    fill: var(--sl-color-gray-3);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .pipeline figcaption {
    margin-top: 0.6rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
