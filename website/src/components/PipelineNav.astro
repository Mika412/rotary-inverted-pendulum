---
/**
 * The pipeline as a compact strip, for the top of every step page.
 *
 * Lets you jump between steps without going back to the overview, and shows
 * where you are in the sequence — the thing a sidebar alone doesn't convey,
 * because the sidebar is a list of pages, not a process with a position in it.
 *
 * Deliberately HTML and CSS rather than SVG, unlike `PipelineDiagram.astro`:
 * this is navigation. Real anchors get keyboard focus and browser affordances
 * for free, `aria-current` announces the active step to a screen reader, and
 * flex wrapping handles narrow viewports without a horizontal scrollbar.
 *
 * Renders nothing on pages that are not pipeline steps, so it can be mounted
 * globally via the `PageTitle` override without leaking onto reference pages.
 */
import { PIPELINE_STEPS } from '../data/pipeline';

const currentSlug = Astro.locals.starlightRoute.id;
const isStep = PIPELINE_STEPS.some((s) => s.slug === currentSlug);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (slug: string) => `${base}/${slug}/`;
---

{
  isStep && (
    <nav class="pipeline-nav" aria-label="Pipeline steps">
      <ol>
        {PIPELINE_STEPS.map((step) => {
          const current = step.slug === currentSlug;
          return (
            <li>
              <a
                href={url(step.slug)}
                aria-current={current ? 'step' : undefined}
                class:list={['step', { 'step--current': current, 'step--optional': !step.tethered }]}
              >
                <span class="n">{step.n}</span>
                <span class="label">{step.short ?? step.title}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </nav>
  )
}

<style>
  .pipeline-nav {
    margin: 0.5rem 0 0.25rem;
  }

  .pipeline-nav ol {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Starlight's content styles add list markers and margins; opt out. */
  .pipeline-nav li {
    margin: 0;
    padding: 0;
  }

  .step {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.55rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      color 0.15s ease;
  }

  .step:hover,
  .step:focus-visible {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  /* Steps 4–6 remove the tether and are optional; mirror the dashed outline
     the full diagram uses for them. */
  .step--optional {
    border-style: dashed;
  }

  .step--current {
    border-color: var(--sl-color-accent);
    border-style: solid;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .n {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    color: var(--sl-color-accent);
  }

  .step--current .n {
    color: var(--sl-color-white);
  }

  /* On narrow screens the numbers alone carry the sequence, and the current
     step keeps its name so you still know where you are. */
  @media (max-width: 30rem) {
    .step:not(.step--current) .label {
      display: none;
    }
  }
</style>
