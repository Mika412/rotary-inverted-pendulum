---
/**
 * The two cooperating threads of `finetune_async.py`, as a diagram.
 *
 * Hand-authored SVG, following `PipelineDiagram.astro`: no dependency, no
 * client JavaScript, crisp at any zoom, and it follows Starlight's light/dark
 * theme tokens.
 *
 * This replaces an ASCII-art version that had drifted in three ways, all of
 * which the structure here makes hard to repeat:
 *   - it hard-coded "strict 100Hz / every 10 ms"; the rate is now read from
 *     the generated constants, so it tracks the firmware;
 *   - it drew one arrow, control -> learner, and so implied a one-way
 *     handoff. There are two shared objects and they flow in *opposite*
 *     directions: transitions out to the learner, refreshed policy weights
 *     back to the control thread. That loop is the whole architecture;
 *   - its box borders were a column out of alignment, and at 84 columns wide
 *     it was a diagram phone readers had to scroll sideways.
 */
import constants from '../generated/constants.json';

const rateHz: number = constants.control.frequencyHz;
const tickMs = 1000 / rateHz;
const tick = Number.isInteger(tickMs) ? `${tickMs}` : tickMs.toFixed(1);

interface Line {
  code: string;
  indent?: number;
}

// Order matches `AsyncControlLoop.run_episode`: predict and apply first, pace
// to the deadline, then observe and post the transition.
const controlLines: Line[] = [
  { code: 'action ← snapshot.predict(obs)' },
  { code: 'env.apply_action(action)' },
  { code: 'sleep, then busy-wait to the tick' },
  { code: 'next_obs, r ← env.observe_and_step()' },
  { code: 'queue.put(transition)' },
];

// Order matches the learner block in `finetune_async.main`.
const learnerLines: Line[] = [
  { code: 'transitions ← queue.drain()' },
  { code: 'replay_buffer.add(transitions)' },
  { code: 'if past warmup:' },
  { code: 'model.train(K gradient steps)', indent: 1 },
  { code: 'snapshot.refresh_from(actor)', indent: 1 },
];

// Geometry. One place to change spacing; everything else is derived. PANEL_W
// has to clear the longest code line at CODE_SIZE — `env.observe_and_step()`
// is 36 monospace characters — or the text spills over the panel border.
const PANEL_W = 286;
const PANEL_Y = 40;
const PANEL_H = 220;
const LEFT_X = 8;
const LANE_W = 150;
const RIGHT_X = LEFT_X + PANEL_W + LANE_W;
const LANE_MID = LEFT_X + PANEL_W + LANE_W / 2;
const CODE_Y = PANEL_Y + 88;
const CODE_STEP = 22;
const VIEW_W = RIGHT_X + PANEL_W + LEFT_X;
const VIEW_H = 300;

const QUEUE_Y = 146;
const SNAPSHOT_Y = 222;

const codeY = (i: number) => CODE_Y + i * CODE_STEP;
---

<figure class="threads">
  <svg
    viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
    role="img"
    aria-labelledby="threads-title threads-desc"
    preserveAspectRatio="xMidYMid meet"
  >
    <title id="threads-title">Two threads, coupled by two lock-protected objects</title>
    <desc id="threads-desc">
      A control thread runs in the background at a strict {rateHz} hertz, one
      tick every {tick} milliseconds: it predicts an action from the policy
      snapshot, applies it to the rig, paces itself to the next deadline, then
      observes the result and posts a transition. A learner thread runs on the
      main thread at best effort: it drains those transitions into the replay
      buffer and, once past warmup, runs gradient steps and refreshes the
      snapshot. The two never block on each other. They communicate through a
      bounded transition queue flowing from control to learner, and a policy
      snapshot flowing back from learner to control.
    </desc>

    <defs>
      <marker
        id="threads-arrow"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" class="arrowhead" />
      </marker>
    </defs>

    {/* Control thread: holds the rate, owns the rig. */}
    <g class="panel">
      <rect x={LEFT_X} y={PANEL_Y} width={PANEL_W} height={PANEL_H} rx="10" />
      <text x={LEFT_X + 16} y={PANEL_Y + 28} class="panel-title">Control thread</text>
      <text x={LEFT_X + 16} y={PANEL_Y + 50} class="panel-sub">
        background · strict {rateHz} Hz
      </text>
      <text x={LEFT_X + 16} y={codeY(0) - 22} class="loop-label">
        every {tick} ms:
      </text>
      {
        controlLines.map((l, i) => (
          <text x={LEFT_X + 16 + (l.indent ?? 0) * 12} y={codeY(i)} class="code">
            {l.code}
          </text>
        ))
      }
    </g>

    {/* Learner thread: unbounded work, no deadline. */}
    <g class="panel">
      <rect x={RIGHT_X} y={PANEL_Y} width={PANEL_W} height={PANEL_H} rx="10" />
      <text x={RIGHT_X + 16} y={PANEL_Y + 28} class="panel-title">Learner thread</text>
      <text x={RIGHT_X + 16} y={PANEL_Y + 50} class="panel-sub">main · best effort</text>
      <text x={RIGHT_X + 16} y={codeY(0) - 22} class="loop-label">loop:</text>
      {
        learnerLines.map((l, i) => (
          <text x={RIGHT_X + 16 + (l.indent ?? 0) * 12} y={codeY(i)} class="code">
            {l.code}
          </text>
        ))
      }
    </g>

    {/* The two channels, flowing in opposite directions. This loop IS the
        architecture: neither arrow is a blocking call. */}
    <line
      x1={LEFT_X + PANEL_W + 8}
      y1={QUEUE_Y}
      x2={RIGHT_X - 8}
      y2={QUEUE_Y}
      class="channel"
      marker-end="url(#threads-arrow)"
    />
    <text x={LANE_MID} y={QUEUE_Y - 12} class="channel-name">TransitionQueue</text>
    <text x={LANE_MID} y={QUEUE_Y + 20} class="channel-sub">bounded deque · lock</text>

    <line
      x1={RIGHT_X - 8}
      y1={SNAPSHOT_Y}
      x2={LEFT_X + PANEL_W + 8}
      y2={SNAPSHOT_Y}
      class="channel"
      marker-end="url(#threads-arrow)"
    />
    <text x={LANE_MID} y={SNAPSHOT_Y - 12} class="channel-name">PolicySnapshot</text>
    <text x={LANE_MID} y={SNAPSHOT_Y + 20} class="channel-sub">locked actor copy</text>
  </svg>
  <figcaption>
    The control thread never blocks on the learner; the learner never blocks on
    the rig. A third lock, inside <code>LowLevelClient</code>, serialises each
    serial transaction. The replay buffer is the learner's alone — only drained
    transitions reach it.
  </figcaption>
</figure>

<style>
  .threads {
    margin: 1.75rem 0;
  }

  /* Wide content must scroll inside its own box rather than the page body. */
  .threads svg {
    display: block;
    width: 100%;
    min-width: 34rem;
    height: auto;
  }

  @media (max-width: 40rem) {
    .threads {
      overflow-x: auto;
    }
  }

  .panel rect {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-gray-5);
    stroke-width: 1.5;
  }

  .panel-title {
    fill: var(--sl-color-white);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .panel-sub {
    fill: var(--sl-color-accent);
    font-size: 0.78rem;
  }

  .loop-label {
    fill: var(--sl-color-gray-3);
    font-size: 0.75rem;
    font-style: italic;
  }

  .code {
    fill: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
  }

  .channel {
    stroke: var(--sl-color-accent);
    stroke-width: 1.75;
    fill: none;
  }

  .arrowhead {
    fill: var(--sl-color-accent);
  }

  .channel-name {
    fill: var(--sl-color-white);
    font-size: 0.8rem;
    font-weight: 600;
    text-anchor: middle;
  }

  .channel-sub {
    fill: var(--sl-color-gray-3);
    font-size: 0.7rem;
    text-anchor: middle;
  }

  .threads figcaption {
    margin-top: 0.6rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
