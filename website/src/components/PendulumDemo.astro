---
/**
 * The landing-page demo island.
 *
 * Server-rendered as a static, readable panel; the 3D canvas and simulation
 * hydrate on the client. Everything visible before hydration is real content,
 * so the page is never a blank box waiting on JavaScript.
 */
import constants from '../generated/constants.json';
import { WINDOW as SPARK_WINDOW } from '../demo/sparkline.ts';

const { control, policy } = constants;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// One entry per strip chart. `key` is what the client keys its Sparkline map
// on, so the markup and the script cannot drift apart silently.
//
// These are the network's own channels, not derived scores. The first five are
// literally its input frame; the last is its output. Two earlier tiles are
// gone on purpose: "balanced fraction" and "upright for" scored the demo rather
// than showing the controller, and "angle from upright" is discontinuous — it
// jumps by 360° through the bottom of the swing, which is exactly why the
// network is fed sin and cos instead of the angle itself.
// Labels are short because all six share one row — about 160 px of canvas each.
const plots = [
  { key: 'motorPos', label: 'Motor pos', unit: 'rad', role: 'in' },
  { key: 'sinTheta', label: 'sin θ', unit: '', role: 'in' },
  { key: 'cosTheta', label: 'cos θ', unit: '', role: 'in' },
  { key: 'motorVel', label: 'Motor vel', unit: 'rad/s', role: 'in' },
  { key: 'penVel', label: 'Pend vel', unit: 'rad/s', role: 'in' },
  { key: 'action', label: 'Action', unit: 'out', role: 'out' },
];

// Derived, never restated: the trace length is a property of the Sparkline, and
// the stack duration falls out of the rate.
const historyS = SPARK_WINDOW / control.frequencyHz;
const stackMs = Math.round((1000 * control.obsFrames) / control.frequencyHz);
---

<div class="demo" data-demo data-base-url={base}>
  <div class="demo__stage">
    <canvas data-canvas aria-label="3D view of the rotary inverted pendulum"></canvas>

    <div class="demo__overlay demo__overlay--top">
      <p class="demo__badge" data-mode-label>
        live · MuJoCo in your browser · {control.frequencyHz} Hz
      </p>
      <label class="demo__toggle">
        <input type="checkbox" data-control-toggle checked />
        <span class="demo__toggle-track" aria-hidden="true"></span>
        <span data-control-label>Control on</span>
      </label>
    </div>

    <div class="demo__overlay demo__overlay--bottom">
      <p class="demo__badge" data-demo-hint></p>
    </div>
    <p class="demo__status" data-status>Loading…</p>

    <noscript>
      <p class="demo__status">
        The interactive demo needs JavaScript. The rig balances itself with a
        {policy.paramCount}-parameter network running on an Arduino Nano — the
        documentation below explains how it gets there.
      </p>
    </noscript>
  </div>

  <div class="demo__plots">
    {
      plots.map((p) => (
        <figure class:list={['demo__plot', { 'demo__plot--out': p.role === 'out' }]}>
          <figcaption>
            <span>
              {p.label}
              {p.unit && <i>{p.unit}</i>}
            </span>
            <b data-plot-value={p.key}>—</b>
          </figcaption>
          <canvas data-plot={p.key} aria-hidden="true"></canvas>
        </figure>
      ))
    }
  </div>

  <p class="demo__legend">
    The five inputs the {policy.paramCount}-parameter network reads, and the one
    action it writes — {control.frequencyHz} times a second. Each trace is{' '}
    {historyS.toFixed(1)} s of history; the{' '}
    <span class="demo__legend-swatch" aria-hidden="true"></span> shaded sliver on
    the right is the {control.obsFrames}-frame stack it is reading <em>now</em>{' '}
    ({stackMs} ms). Everything left of it the policy has already forgotten.
  </p>

  <p class="demo__footnote">
    <strong>{policy.architecture}</strong> · {policy.paramCount} parameters
    · {policy.flashBytes} bytes of flash · {control.frequencyHz} Hz — the same
    weights the Arduino is flashed with.
  </p>
</div>

<script>
  import { mountDemo } from '../demo/index.ts';

  const root = document.querySelector<HTMLElement>('[data-demo]');
  if (root) {
    mountDemo(root).catch((err) => {
      console.error('demo failed to start', err);
      const status = root.querySelector('[data-status]');
      if (status) status.textContent = 'The interactive demo failed to start.';
    });
  }
</script>

<style>
  .demo {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-block: 2rem;
    container-type: inline-size;
  }

  .demo__stage {
    position: relative;
    min-height: 24rem;
    border-radius: 0.75rem;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 50% 35%,
        color-mix(in srgb, var(--sl-color-accent) 14%, transparent),
        transparent 70%
      ),
      var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
  }

  .demo__stage canvas {
    display: block;
    width: 100%;
    height: 100%;
    /* The canvas owns the drag gesture for orbiting and for pushing the
       pendulum; vertical panning still works because the wheel handler yields
       at the zoom limits. */
    touch-action: pan-y;
  }

  /* Overlays sit above the canvas but must not swallow the drag gesture —
     only the toggle itself takes pointer events. */
  .demo__overlay {
    position: absolute;
    inset-inline: 0;
    margin: 0;
    padding: 0.6rem 0.75rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
    font-size: var(--sl-text-xs);
  }

  .demo__overlay--top {
    top: 0;
  }

  .demo__overlay--bottom {
    bottom: 0;
    justify-content: center;
    text-align: center;
    min-height: 2.1rem;
  }

  .demo__badge:empty {
    display: none;
  }

  .demo__badge {
    margin: 0;
    padding: 0.2rem 0.5rem;
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--sl-color-black) 65%, transparent);
    color: var(--sl-color-gray-2);
    font-variant-numeric: tabular-nums;
  }

  .demo__toggle {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.5rem 0.2rem 0.35rem;
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--sl-color-black) 65%, transparent);
    color: var(--sl-color-gray-2);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }

  .demo__toggle input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .demo__toggle-track {
    position: relative;
    width: 1.9rem;
    height: 1.05rem;
    border-radius: 999px;
    background: var(--sl-color-gray-5);
    transition: background 0.15s ease;
    flex: none;
  }

  .demo__toggle-track::after {
    content: '';
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--sl-color-white);
    transition: transform 0.15s ease;
  }

  .demo__toggle input:checked + .demo__toggle-track {
    background: var(--sl-color-accent);
  }

  .demo__toggle input:checked + .demo__toggle-track::after {
    transform: translateX(0.85rem);
  }

  .demo__toggle input:focus-visible + .demo__toggle-track {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }

  .demo__status {
    position: absolute;
    inset-inline: 0;
    top: 50%;
    margin: 0;
    text-align: center;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    pointer-events: none;
  }

  .demo__status:empty {
    display: none;
  }

  .demo__plots {
    display: grid;
    /* One row: the whole input frame plus the output, left to right in the order
       the network sees them. See the WINDOW note in sparkline.ts — the column
       count and the retained sample count are chosen together, so that the
       K-frame highlight keeps its width. */
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.5rem;
  }

  @container (max-width: 60rem) {
    .demo__plots {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @container (max-width: 34rem) {
    .demo__plots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .demo__plot {
    margin: 0;
    padding: 0.5rem 0.6rem 0.35rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
  }

  .demo__plot figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  /* A label that outgrows its tile truncates rather than pushing the value out. */
  .demo__plot figcaption span {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .demo__plot figcaption b {
    color: var(--sl-color-white);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .demo__plot canvas {
    display: block;
    width: 100%;
    height: 2.75rem;
    margin-top: 0.35rem;
    /* The Sparkline reads these: `color` is the trace, --spark-grid the
       baseline. Setting them here keeps the chart on the site's theme. */
    color: var(--sl-color-accent-high);
    --spark-grid: var(--sl-color-gray-5);
    /* The stacked-frame band. Recessive on purpose: it is annotation, not data,
       and it sits behind the trace. */
    --spark-window: var(--sl-color-accent-low);
  }

  /* The output tile carries the same trace colour as the inputs — identity here
     comes from the label and the position, not from a second hue. Its border is
     what marks it as the other side of the network. */
  .demo__plot--out {
    border-color: var(--sl-color-accent);
  }

  .demo__plot figcaption i {
    margin-left: 0.3em;
    font-style: normal;
    color: var(--sl-color-gray-4);
  }

  .demo__legend {
    margin: 0.6rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .demo__legend-swatch {
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    vertical-align: -0.1em;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.15em;
    background: var(--sl-color-accent-low);
  }

  .demo__footnote {
    margin: 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    line-height: 1.5;
  }
</style>
