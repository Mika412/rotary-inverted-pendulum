{
  "name": "rotary-inverted-pendulum-docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site for the rotary inverted pendulum, including the in-browser demo of the deployed policy.",
  "scripts": {
    "prebuild": "node scripts/prepare.mjs",
    "dev": "node scripts/prepare.mjs && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "npm run test:policy && npm run test:geometry",
    "test:policy": "node --experimental-strip-types tests/policy_balances.test.mts",
    "test:geometry": "node --experimental-strip-types tests/scene_geometry.test.mts",
    "test:smoke": "node tests/demo_smoke.test.mjs",
    "export-assets": "uv run --project ../RotaryInvertedPendulum-python python scripts/export_assets.py"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.4",
    "@mujoco/mujoco": "^3.10.0",
    "astro": "^7.1.3",
    "three": "^0.185.1"
  }
}
